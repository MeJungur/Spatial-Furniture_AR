# This .gitignore file should be placed at the root of your Unity project.
#
# Ignore temporary folders generated by Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Logs]/
/[Uu]serSettings/

# Memory captures and analytics
/[Mm]emoryCaptures/

# Asset store packages (if you don't want to upload large asset files)
# Keep this commented out if you want to upload assets, but ignore library folders:
# /[Aa]ssets/AssetStoreTools*

# Ignore OS generated files
.DS_Store
Thumbs.db

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.tlog

# Unity WebGl build output
/[Aa]ssets/[Ss]platmaps/
/[Aa]ssets/[Gg]aussianAssets/*.bytes

# Ignore APK builds (recommended to upload to GitHub Releases instead of git commit)
*.apk

# Crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage
